# ---------------------------------------------------------------------------
# Maison Asili — environment configuration
#
# Copy this file to `.env.local` for local development and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Resend API key used by the server to send order requests and enquiries.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where Maison Asili receives wholesale order requests.
# Defaults to info@maisonasili.com when left empty. Comma-separate several
# addresses if needed.
ORDER_NOTIFICATION_EMAIL=info@maisonasili.com

# Where contact and wholesale enquiry emails are sent.
# Defaults to ORDER_NOTIFICATION_EMAIL when left empty.
ENQUIRY_NOTIFICATION_EMAIL=info@maisonasili.com

# The sender that appears on outbound email. This address/domain must be
# verified in Resend. Do not use an address you have not verified.
# Example: Maison Asili <orders@maisonasili.com>
ORDER_FROM_EMAIL=

# Public URL of the deployed site, used for same-origin checks on form posts.
# Optional in local development; recommended in production.
NEXT_PUBLIC_SITE_URL=

# Development/test only. Set to `log` to record outbound emails in the server
# log instead of sending them. Ignored in production. Never enable on a live
# deployment.
EMAIL_TRANSPORT=
