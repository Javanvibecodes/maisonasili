{
  "name": "maison-asili-store",
  "version": "1.0.0",
  "private": true,
  "description": "Maison Asili — luxury Afro-Gourmet e-commerce frontend demonstration (static, no backend).",
  "scripts": {
    "assets": "node scripts/download-assets.js",
    "build": "node scripts/build.js && npm run build:css",
    "build:css": "npx tailwindcss -i src/input.css -o public/assets/css/styles.css --minify",
    "dev": "npm run build && node scripts/serve.js",
    "start": "node scripts/serve.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
